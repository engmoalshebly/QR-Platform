  "components": {
    "schemas": {
      "ClientCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "daily_limit": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Daily Limit",
            "default": 1000
          },
          "per_minute": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Per Minute",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ClientCreate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Review": {
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "sent",
              "not_sent"
            ],
            "title": "Outcome"
          },
          "evidence": {
            "type": "string",
            "maxLength": 500,
            "minLength": 20,
            "title": "Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "outcome",
          "evidence"
        ],
        "title": "Review"
      },
      "Send": {
        "properties": {
          "channel": {
            "type": "string",
            "const": "whatsapp",
            "title": "Channel",
            "default": "whatsapp"
          },
          "to": {
            "type": "string",
            "maxLength": 30,
            "minLength": 8,
            "title": "To"
          },
          "text": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "to",
          "text"
        ],
        "title": "Send"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
