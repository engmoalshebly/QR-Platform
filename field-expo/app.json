{
  "expo": {
    "name": "دعوة الميداني",
    "slug": "qentry-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/dawaa-app-icon-navy.png",
    "userInterfaceStyle": "dark",
    "scheme": "qentry-field",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qentry.field",
      "infoPlist": {
        "NSCameraUsageDescription": "يحتاج دعوة الميداني إلى الكاميرا لمسح دعوات الحضور عند البوابة فقط."
      }
    },
    "android": {
      "package": "com.qentry.field",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EE",
        "foregroundImage": "./assets/brand/dawaa-symbol-navy-gold-transparent.png",
        "monochromeImage": "./assets/brand/dawaa-symbol-black-monochrome-transparent.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج دعوة الميداني إلى الكاميرا لمسح دعوات الحضور عند البوابة فقط.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/brand/dawaa-app-icon-navy.png"
    }
  }
}
