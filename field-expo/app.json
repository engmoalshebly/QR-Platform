{
  "expo": {
    "name": "Qentry Field",
    "slug": "qentry-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "qentry-field",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qentry.field",
      "infoPlist": {
        "NSCameraUsageDescription": "يحتاج Qentry Field إلى الكاميرا لمسح دعوات الحضور عند البوابة فقط."
      }
    },
    "android": {
      "package": "com.qentry.field",
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج Qentry Field إلى الكاميرا لمسح دعوات الحضور عند البوابة فقط.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
