[Unit]
Description=Qentry production stack
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/qentry
ExecStart=/opt/qentry/scripts/ops/qentry-compose.sh up -d
ExecStop=/opt/qentry/scripts/ops/qentry-compose.sh stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
