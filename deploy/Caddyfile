# Edge proxy for Qentry: management console, API, field scanner, and the
# self-hosted Supabase endpoints.
#
# Deployment assumption: both hostnames are proxied by Cloudflare in "Full
# (strict)" mode.  TLS to the origin uses the Cloudflare Origin CA certificate
# in /etc/qentry/certs (mounted at /certs); it must cover both hostnames (a
# *.example.com certificate does).  Cloudflare connects from its own address
# ranges, so the real visitor address is taken from CF-Connecting-IP, and only
# when the connection really comes from Cloudflare.

{
	servers {
		# Cloudflare ranges (https://www.cloudflare.com/ips).  Refresh when
		# Cloudflare publishes changes; see RUNBOOK.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(security_headers) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(console_headers) {
	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
	}
}

{$QENTRY_DOMAIN} {
	tls /certs/origin.crt /certs/origin.key
	encode zstd gzip
	import security_headers

	# Operational endpoints are never public.  /metrics is additionally guarded
	# by METRICS_ACCESS_TOKEN inside the API.
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}

	# API, health probes and the isolated field scanner are served by FastAPI,
	# which sets its own CSP/Permissions-Policy per surface.
	@backend path /api/* /health /health/* /field /field/*
	handle @backend {
		# Largest legitimate upload is the organization document (5 MB,
		# validated again by the API).
		request_body {
			max_size 6MB
		}
		reverse_proxy api:9000 {
			# Overwrite rather than append: clients must not forge the address
			# used for rate limiting and audit logs.  {client_ip} is the
			# CF-Connecting-IP value when the peer is Cloudflare, else the peer.
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto {scheme}
			header_up Host {host}
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# Management console (static SPA).  The console must never be camera
	# capable; that permission exists only under /field/ (set by the API).  These
	# headers therefore apply to the static handlers only -- applying them
	# site-wide would duplicate the API's own headers and, for Permissions-Policy,
	# silently disable the scanner camera.
	handle /assets/* {
		import console_headers
		root * /srv/console
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Self-hosted font files are content-hashed.
	handle /fonts/google/*.woff2 {
		import console_headers
		root * /srv/console
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		import console_headers
		root * /srv/console
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}

# Self-hosted Supabase.  Two audiences:
#   * the API container, which reaches this name over the private `app`
#     network (172.28.20.0/24) and may use Auth admin + Storage in full;
#   * the public internet, which may only follow email links and fetch
#     signed/public storage objects.  Signup, token, admin and REST are not
#     reachable from outside.
(supabase_routes) {
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy auth:9999
	}
	handle /storage/v1/* {
		uri strip_prefix /storage/v1
		reverse_proxy storage:5000
	}
}

{$SUPABASE_DOMAIN} {
	tls /certs/origin.crt /certs/origin.key
	encode zstd gzip
	import security_headers

	# .1 is the Docker bridge gateway: connections that arrive through the
	# userland proxy (IPv6, localhost) are seen from there and are NOT internal.
	@private {
		remote_ip 172.28.20.0/24
		not remote_ip 172.28.20.1
	}
	handle @private {
		import supabase_routes
	}

	@public_ok path /auth/v1/verify /auth/v1/callback /storage/v1/object/sign/* /storage/v1/object/public/*
	handle @public_ok {
		import supabase_routes
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format json
	}
}
