# Fill only after provisioning the destination and verifying its host-key fingerprint.
# Store operational values in the private backup.env, never commit SSH private keys.
BACKUP_SSH_HOST=backup-server
BACKUP_SSH_DIR=/backups/qentry
# Use an absolute installed script path for the scheduled service.
BACKUP_OFFSITE_CMD='/absolute/path/to/scripts/ops/offsite_ssh.sh "$1"'
# Remove BACKUP_ALLOW_LOCAL_ONLY when the verified destination is enabled.
