# /etc/qentry/app.env  (mode 600, root:root).  Copy, fill, never commit.
# Every key below is required by app/config.py::validate_for_production.
# The API refuses to start if any is missing or weak.

APP_ENV=production
APP_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Only if the issuer differs from SUPABASE_URL/auth/v1
SUPABASE_JWT_ISSUER=

# Application role (migration_v52).  Replace the placeholder password first.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@<pooler-host>:5432/postgres
DATABASE_APP_URL=postgresql+asyncpg://qentry_app.<ref>:<password>@<pooler-host>:5432/postgres

# 32+ bytes each, generated independently: openssl rand -base64 48
INVITE_HMAC_SECRET=
INVITE_HMAC_SECRET_PREV=
OTP_HMAC_SECRET=
ORG_REQUEST_ENCRYPTION_KEY=
METRICS_ACCESS_TOKEN=

PLATFORM_ADMIN_REQUIRE_AAL2=true
PLATFORM_SUPERADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Qentry

LINK_GATEWAY_API_KEY=
SENTRY_DSN=
TRUSTED_PROXY_IPS=172.28.10.2
