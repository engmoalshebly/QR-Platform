# /etc/qentry/app.env  (mode 600, root:root).  Copy, fill, never commit.
# Every key below is required by app/config.py::validate_for_production.
# The API refuses to start if any is missing or weak.

APP_ENV=production
# The console and the API share one origin (Caddy routes /api/*).
APP_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Self-hosted Supabase behind Caddy (same values as compose.env).
SUPABASE_URL=https://supabase.example.com
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Only if the issuer differs from SUPABASE_URL/auth/v1
SUPABASE_JWT_ISSUER=

# Application role (migration_v52).  Replace the placeholder password first.
# Postgres runs in the same stack (service name `db`, never published).
# The database is on the private compose network, so TLS is disabled.  Remove
# this line (default "verify") when pointing at a remote/managed database.
DATABASE_SSL=disable
DATABASE_URL=postgresql+asyncpg://postgres:<POSTGRES_PASSWORD>@db:5432/postgres
DATABASE_APP_URL=postgresql+asyncpg://qentry_app:<APP_ROLE_PASSWORD>@db:5432/postgres

# 32+ bytes each, generated independently: openssl rand -base64 48
INVITE_HMAC_SECRET=
INVITE_HMAC_SECRET_PREV=
OTP_HMAC_SECRET=
ORG_REQUEST_ENCRYPTION_KEY=
METRICS_ACCESS_TOKEN=

PLATFORM_ADMIN_REQUIRE_AAL2=true
PLATFORM_SUPERADMIN_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Qentry

# Online payments are disabled (manual approval, RUNBOOK 6a): the gateway key
# is optional and may stay empty.
LINK_GATEWAY_API_KEY=
SENTRY_DSN=
TRUSTED_PROXY_IPS=172.28.20.2

# WhatsApp / OpenWA (disabled until migration, service and session are ready)
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://openwa-api:2785
OPENWA_MASTER_KEY=
# Separate, stable random secret >= 32 characters; back up securely.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_DISPATCH_INTERVAL_SECONDS=5

# Durable generation admission (P1); keep false until the P2 worker is ready.
GENERATION_OPERATIONS_ENABLED=false
# Enable only after v80 + tested consumer; start compose profile generation.
GENERATION_WORKER_ENABLED=false
GENERATION_WORKSPACE_DIR=/var/lib/qentry/generation
GENERATION_WORKSPACE_MAX_BYTES=2147483648
GENERATION_WORKSPACE_JOB_BYTES=268435456
GENERATION_EXPORT_MAX_BYTES=33554432
GENERATION_EXPORT_MAX_PAGES=50
GENERATION_OPERATION_MAX_CARDS=1000
GENERATION_BATCH_CARDS=250
GENERATION_QUEUE_MAX_OPERATIONS=1000
GENERATION_QUEUE_MAX_CARDS=100000
GENERATION_TENANT_MAX_OPERATIONS=10
# Fair dispatch: unfinished batches allowed in the broker at once (next one comes from the least-loaded tenant).
GENERATION_DISPATCH_WINDOW=3
# A never-claimed batch is failed as DISPATCH_STALLED after this many re-publications.
GENERATION_REPUBLISH_MAX=20
# Housekeeping (abandoned workspaces, expired uploads, orphan objects) cadence; publishing stays on its own 5s loop.
GENERATION_CLEANUP_INTERVAL_SECONDS=120
