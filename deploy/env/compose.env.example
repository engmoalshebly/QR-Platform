# /etc/qentry/compose.env  (mode 600, root:root).  Read by docker compose via
# scripts/ops/qentry-compose.sh.  Generate with scripts/ops/generate_secrets.sh.

# Public hostnames; both must have DNS A records pointing at this server.
QENTRY_DOMAIN=dawaa.prideidea.com
# One label under the zone (Cloudflare Universal SSL does not cover two levels).
SUPABASE_DOMAIN=supabase.prideidea.com
APP_URL=https://dawaa.prideidea.com

# Release image (tag or digest).  For a build on this host use qentry-api:local
# together with deploy/docker-compose.build.yml.
QENTRY_IMAGE=qentry-api:local
# Only needed with `--profile payments` (payments are disabled today).
LINK_GATEWAY_IMAGE=

# Secrets (generate_secrets.sh creates all of these).
REDIS_PASSWORD=
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# GoTrue sends its own mail (confirmations, recovery); reuse the app's SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Qentry
