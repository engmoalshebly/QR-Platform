# /etc/qentry/compose.env  (mode 600, root:root). Read by docker compose.
QENTRY_DOMAIN=api.example.com
# Digest of the release image produced by .github/workflows/release.yml
QENTRY_IMAGE=ghcr.io/<owner>/qentry-api@sha256:<digest>
LINK_GATEWAY_IMAGE=ghcr.io/<owner>/qentry-link-gateway@sha256:<digest>
# openssl rand -hex 32
REDIS_PASSWORD=
