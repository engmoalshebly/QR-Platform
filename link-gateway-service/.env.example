# ============================================
# Link Gateway Service - Environment Variables
# ============================================

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:9000

# ──────────────────────────────────────────────
# Supabase Database
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────────────
# Link Unified Gateway
# ──────────────────────────────────────────────
LINK_GATEWAY_BASE_URL=https://payment-test.tharwatt.com
# tharwatt = direct API used by payment-test.tharwatt.com
# unified = OAuth + X-API-* contract
LINK_API_PROFILE=tharwatt
# Obtain the exact production status endpoint from Link before go-live.
LINK_STATUS_PATH=/replace-with-link-status-endpoint
LINK_REQUEST_TIMEOUT_MS=15000
LINK_CLIENT_ID=halali-app
LINK_CLIENT_SECRET=your-client-secret

# Merchant identity on Link
LINK_MERCHANT_ORG_CODE=YOUR_ORG_CODE
LINK_MERCHANT_ACCOUNT_TYPE=MerchantId
LINK_MERCHANT_ACCOUNT_ID=YOUR_MERCHANT_ID
LINK_FIXED_FEE_YER=0
LINK_FIXED_COMMISSION_YER=0
# Comma-separated HTTPS hosts returned by Link for wallet logos.
LINK_LOGO_HOSTS=payment-test.tharwatt.com

# ──────────────────────────────────────────────
# Redis (for Token Manager + Lookup Cache)
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ──────────────────────────────────────────────
# Internal API Security
# ──────────────────────────────────────────────
API_KEY=your-internal-api-key
