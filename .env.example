# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Direct connection for SQLAlchemy; production enforces TLS)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
# Non-superuser connection for RLS enforcement (production: apply migration_v52 first)
# DATABASE_APP_URL=postgresql+asyncpg://qentry_app:secure-password@db.your-project.supabase.co:5432/postgres

# Link Gateway
LINK_GATEWAY_URL=http://localhost:3000
LINK_GATEWAY_API_KEY=link_sec_sandbox_test_key

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ADMIN_EMAIL=your-email@gmail.com
SMTP_SENDER_NAME=Qr Platform

# App
APP_URL=http://localhost:9000
APP_ENV=development
RUN_EMBEDDED_SCHEDULER=false
SUPABASE_JWT_ISSUER=

# Error tracking (optional — leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# HTTP and public-endpoint hardening. In production, set explicit values and
# list only reverse-proxy addresses/CIDRs that are permitted to forward client IPs.
CONTENT_SECURITY_POLICY=
TRUSTED_PROXY_IPS=
METRICS_ACCESS_TOKEN=replace-with-a-long-random-secret
METRICS_MAX_SERIES=500
PASSWORD_MIN_LENGTH=12
OTP_HMAC_SECRET=replace-with-a-dedicated-long-random-secret
ORG_REQUEST_ENCRYPTION_KEY=replace-with-a-dedicated-long-random-secret
ORG_REQUEST_UPLOAD_MAX_BYTES=5242880

# Platform-admin hardening.  Production requires AAL2 and at least one
# comma-separated break-glass administrator email.
PLATFORM_ADMIN_REQUIRE_AAL2=false
PLATFORM_SUPERADMIN_EMAILS=admin@example.com

# Invitation Security (dedicated HMAC key — do NOT reuse JWT secret)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotation policy: every 90 days, move current → _PREV, set new primary
# Only current + prev are checked (2-key window)
INVITE_HMAC_SECRET=your-dedicated-hmac-secret-64-hex-chars
INVITE_HMAC_SECRET_PREV=
HMAC_ROTATION_DAYS=90

# Worker (Celery + Redis) — production batch processing
# Set USE_WORKER=false for dev (falls back to BackgroundTask)
REDIS_URL=redis://localhost:6379/0
USE_WORKER=true

# Storage (Supabase Storage bucket for invitation assets)
# Create bucket 'invitations' in Supabase Dashboard > Storage
# Set to private, 500MB file size limit
STORAGE_BUCKET=invitations
SIGNED_URL_EXPIRY=3600
DOWNLOAD_URL_EXPIRY=604800
